<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Antivírus Simples</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: transparent;
      padding: 20px;
      color: #e0ffe0;
    }

    h1, h2, h3 { color: #e0ffe0; }

    input, button {
      margin: 5px 0;
      padding: 8px 10px;
      border-radius: 4px;
      border: 1px solid #00ff66;
      background: rgba(0, 0, 0, 0.7);
      color: #e0ffe0;
    }

    button {
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }

    button:hover {
      background: #00ff66;
      color: #000;
      transform: translateY(-1px);
    }

    .safe { color: #00ff66; font-weight: bold; }
    .danger { color: #ff5555; font-weight: bold; }

    .card, li {
      background: rgba(0, 0, 0, 0.6);
      padding: 10px;
      margin-bottom: 10px;
      border: 1px solid #00aa44;
      border-radius: 4px;
    }

    ul { list-style: none; padding: 0; }

    #listaPalavras li:hover {
      background: rgba(0, 255, 100, 0.1);
      cursor: pointer;
    }

    #resultados, #historico, #listaPalavras {
      margin-top: 20px;
    }

    /* Canvas do fundo 3D */
    #bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
    }
  </style>
</head>

<body>

  <canvas id="bg"></canvas>

  <h1>🛡️ Antivírus Simples</h1>

  <p>📂 Selecione arquivos de texto para escanear:</p>
  <input type="file" id="fileInput" accept=".txt" multiple>
  <button id="btnEscanear">Escanear</button>

  <h2>⚠️ Palavras Suspeitas Personalizadas</h2>
  <input type="text" id="novaPalavra" placeholder="Adicionar palavra (ex: spyware)">
  <button id="btnAdicionarPalavra">Adicionar</button>
  <ul id="listaPalavras"></ul>

  <h2>🔍 Resultados:</h2>
  <div id="resultados"></div>

  <div id="historico">
    <h3>🗂️ Histórico de Escaneamentos</h3>
    <ul id="listaHistorico"></ul>
    <button id="btnLimparHistorico">🧹 Limpar Histórico</button>
  </div>

  <!-- Three.js para o fundo 3D -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <!-- Fundo 3D: rede neural Verde Hacker / Matrix -->
  <script>
    const canvas = document.getElementById("bg");
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      60,
      window.innerWidth / window.innerHeight,
      0.1,
      1000
    );

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true
    });

    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(window.devicePixelRatio || 1);
    camera.position.z = 14;

    // Fundo bem escuro, estilo Matrix
    scene.background = new THREE.Color(0x010401);

    // Grupo da rede
    const networkGroup = new THREE.Group();
    scene.add(networkGroup);

    const nodeCount = 90;
    const nodes = [];
    const nodeGeometry = new THREE.SphereGeometry(0.08, 12, 12);
    const baseNodeColor = new THREE.Color(0x00ff66); // verde neon
    const baseLineColor = new THREE.Color(0x00aa44); // verde mais escuro

    // Criar nós
    for (let i = 0; i < nodeCount; i++) {
      const nodeMaterial = new THREE.MeshBasicMaterial({
        color: baseNodeColor.clone().offsetHSL((Math.random() - 0.5) * 0.05, 0.1, 0.05)
      });

      const node = new THREE.Mesh(nodeGeometry, nodeMaterial);

      const radius = 5 * Math.cbrt(Math.random());
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);

      node.position.set(
        radius * Math.sin(phi) * Math.cos(theta),
        radius * Math.sin(phi) * Math.sin(theta),
        radius * Math.cos(phi)
      );

      nodes.push(node);
      networkGroup.add(node);
    }

    // Linhas da rede
    const maxConnections = 4;
    const lineMaterial = new THREE.LineBasicMaterial({
      color: baseLineColor,
      transparent: true,
      opacity: 0.45
    });

    const lineGeometry = new THREE.BufferGeometry();
    const positions = [];

    for (let i = 0; i < nodeCount; i++) {
      const nodeA = nodes[i];
      const distances = [];

      for (let j = 0; j < nodeCount; j++) {
        if (i === j) continue;
        const nodeB = nodes[j];
        const dist = nodeA.position.distanceTo(nodeB.position);
        distances.push({ index: j, dist });
      }

      distances.sort((a, b) => a.dist - b.dist);

      for (let k = 0; k < maxConnections; k++) {
        const idx = distances[k].index;
        const nodeB = nodes[idx];

        positions.push(
          nodeA.position.x, nodeA.position.y, nodeA.position.z,
          nodeB.position.x, nodeB.position.y, nodeB.position.z
        );
      }
    }

    lineGeometry.setAttribute(
      "position",
      new THREE.Float32BufferAttribute(positions, 3)
    );

    const lines = new THREE.LineSegments(lineGeometry, lineMaterial);
    networkGroup.add(lines);

    // Luzes suaves
    const ambient = new THREE.AmbientLight(0x00ff66, 0.4);
    const point1 = new THREE.PointLight(0x00ff99, 0.8, 50);
    point1.position.set(8, 8, 10);
    const point2 = new THREE.PointLight(0x00ff33, 0.6, 40);
    point2.position.set(-8, -5, -10);
    scene.add(ambient, point1, point2);

    // Animação
    let time = 0;
    function animate() {
      requestAnimationFrame(animate);

      time += 0.002;

      networkGroup.rotation.y += 0.0018;
      networkGroup.rotation.x = Math.sin(time * 0.4) * 0.12;

      nodes.forEach((node, i) => {
        const pulsar = 0.6 + Math.sin(time * 5 + i) * 0.3;
        node.scale.setScalar(pulsar);
      });

      renderer.render(scene, camera);
    }

    animate();

    // Resize
    window.addEventListener("resize", () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>

  <!-- Lógica do antivírus -->
  <script>
    const normalizar = texto =>
      texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

    const obterPalavrasSuspeitas = () =>
      JSON.parse(localStorage.getItem("palavrasSuspeitas")) ||
      ["virus", "trojan", "malware", "worm", "hacker"];

    const salvarPalavrasSuspeitas = palavras =>
      localStorage.setItem("palavrasSuspeitas", JSON.stringify(palavras));

    const adicionarPalavra = () => {
      const input = document.querySelector("#novaPalavra");
      const palavra = input.value.trim().toLowerCase();
      if (!palavra) return;

      const palavras = obterPalavrasSuspeitas();
      if (!palavras.includes(palavra)) {
        salvarPalavrasSuspeitas([...palavras, palavra]);
        mostrarListaPalavras();
        input.value = "";
      }
    };

    const mostrarListaPalavras = () => {
      const lista = document.querySelector("#listaPalavras");
      const palavras = obterPalavrasSuspeitas();

      lista.innerHTML = palavras
        .map(p => `<li data-palavra="${p}" title="Clique para remover">${p}</li>`)
        .join("");
    };

    document.querySelector("#listaPalavras").addEventListener("click", e => {
      if (e.target.tagName !== "LI") return;

      const palavra = e.target.dataset.palavra;
      if (confirm(`Remover "${palavra}" da lista negra?`)) {
        const novas = obterPalavrasSuspeitas().filter(p => p !== palavra);
        salvarPalavrasSuspeitas(novas);
        mostrarListaPalavras();
      }
    });

    const escanearArquivos = () => {
      const input = document.querySelector("#fileInput");
      const resultados = document.querySelector("#resultados");
      resultados.innerHTML = "";

      if (!input.files.length) {
        resultados.innerHTML = `<p class="danger">Nenhum arquivo selecionado.</p>`;
        return;
      }

      const palavrasSuspeitas = obterPalavrasSuspeitas();

      [...input.files].forEach(arquivo => {
        const leitor = new FileReader();

        leitor.onload = e => {
          const conteudoOriginal = e.target.result;
          const conteudo = normalizar(conteudoOriginal);

          const encontradas = palavrasSuspeitas.filter(p => conteudo.includes(p));
          const urlsEncontradas = conteudoOriginal.match(/https?:\/\/[^\s]+/g) || [];

          const total = encontradas.length + urlsEncontradas.length;
          const risco = total === 0 ? "Baixo" : total <= 3 ? "Médio" : "Alto";

          resultados.innerHTML += `
            <div class="card">
              <strong>${arquivo.name}</strong><br>
              Palavras suspeitas: ${encontradas.join(", ") || "Nenhuma"}<br>
              URLs encontradas: ${urlsEncontradas.length}<br>
              Risco: <span class="${risco === "Baixo" ? "safe" : "danger"}">${risco}</span>
            </div>
          `;

          salvarNoHistorico(arquivo.name, encontradas, urlsEncontradas, risco);
          mostrarHistorico();
        };

        leitor.readAsText(arquivo);
      });
    };

    const salvarNoHistorico = (nome, palavras, urls, risco) => {
      const historico = JSON.parse(localStorage.getItem("historico")) || [];
      historico.push({
        nome,
        data: new Date().toLocaleString(),
        palavras,
        urls,
        risco
      });
      localStorage.setItem("historico", JSON.stringify(historico));
    };

    const mostrarHistorico = () => {
      const lista = document.querySelector("#listaHistorico");
      const historico = JSON.parse(localStorage.getItem("historico")) || [];

      lista.innerHTML = historico
        .slice()
        .reverse()
        .map(item => `
          <li>
            <strong>${item.nome}</strong> - ${item.data}<br>
            Risco: <span class="${item.risco === "Baixo" ? "safe" : "danger"}">${item.risco}</span><br>
            Palavras: ${item.palavras.join(", ") || "Nenhuma"}<br>
            URLs: ${item.urls.length}
          </li>
        `)
        .join("");
    };

    const limparHistorico = () => {
      localStorage.removeItem("historico");
      mostrarHistorico();
    };

    document.querySelector("#btnAdicionarPalavra").addEventListener("click", adicionarPalavra);
    document.querySelector("#btnEscanear").addEventListener("click", escanearArquivos);
    document.querySelector("#btnLimparHistorico").addEventListener("click", limparHistorico);

    window.addEventListener("DOMContentLoaded", () => {
      mostrarListaPalavras();
      mostrarHistorico();
    });
  </script>

</body>
</html>
