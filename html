<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Antivírus Simples</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: transparent;
      padding: 20px;
      color: #fff;
    }

    h1, h2, h3 { color: #fff; }

    input, button {
      margin: 5px 0;
      padding: 8px;
    }

    .safe { color: #00ff00; font-weight: bold; }
    .danger { color: #ff4444; font-weight: bold; }

    .card, li {
      background: rgba(0,0,0,0.4);
      padding: 10px;
      margin-bottom: 10px;
      border: 1px solid #444;
    }

    ul { list-style: none; padding: 0; }

    #listaPalavras li:hover {
      background: rgba(255,255,255,0.1);
      cursor: pointer;
    }

    #resultados, #historico, #listaPalavras {
      margin-top: 20px;
    }

    /* Canvas do fundo de fumaça */
    #bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
    }
  </style>
</head>

<body>

  <canvas id="bg"></canvas>

  <h1>🛡️ Antivírus Simples</h1>

  <p>📂 Selecione arquivos de texto para escanear:</p>
  <input type="file" id="fileInput" accept=".txt" multiple>
  <button id="btnEscanear">Escanear</button>

  <h2>⚠️ Palavras Suspeitas Personalizadas</h2>
  <input type="text" id="novaPalavra" placeholder="Adicionar palavra (ex: spyware)">
  <button id="btnAdicionarPalavra">Adicionar</button>
  <ul id="listaPalavras"></ul>

  <h2>🔍 Resultados:</h2>
  <div id="resultados"></div>

  <div id="historico">
    <h3>🗂️ Histórico de Escaneamentos</h3>
    <ul id="listaHistorico"></ul>
    <button id="btnLimparHistorico">🧹 Limpar Histórico</button>
  </div>

  <!-- Fundo animado: fumaça volumétrica em canvas 2D -->
  <script>
    const canvasBg = document.getElementById("bg");
    const ctx = canvasBg.getContext("2d");

    let width = window.innerWidth;
    let height = window.innerHeight;
    canvasBg.width = width;
    canvasBg.height = height;

    window.addEventListener("resize", () => {
      width = window.innerWidth;
      height = window.innerHeight;
      canvasBg.width = width;
      canvasBg.height = height;
    });

    class SmokeParticle {
      constructor() {
        this.reset();
      }

      reset() {
        this.x = Math.random() * width;
        this.y = height + Math.random() * 100;
        this.radius = 20 + Math.random() * 60;
        this.alpha = 0.05 + Math.random() * 0.1;
        this.speedY = 0.2 + Math.random() * 0.5;
        this.expansion = 0.02 + Math.random() * 0.04;
        this.wind = (Math.random() - 0.5) * 0.2;
        this.gray = 150 + Math.floor(Math.random() * 80); // tons de cinza
      }

      update() {
        this.y -= this.speedY;
        this.x += this.wind;
        this.radius += this.expansion;
        this.alpha -= 0.0007;

        if (this.alpha <= 0 || this.y + this.radius < -50) {
          this.reset();
        }
      }

      draw(ctx) {
        const grd = ctx.createRadialGradient(
          this.x, this.y, this.radius * 0.1,
          this.x, this.y, this.radius
        );
        grd.addColorStop(0, `rgba(${this.gray}, ${this.gray}, ${this.gray}, ${this.alpha * 2})`);
        grd.addColorStop(1, `rgba(10, 10, 10, 0)`);

        ctx.fillStyle = grd;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    const smokeParticles = [];
    const PARTICLE_COUNT = 70;

    for (let i = 0; i < PARTICLE_COUNT; i++) {
      smokeParticles.push(new SmokeParticle());
    }

    function animateSmoke() {
      ctx.clearRect(0, 0, width, height);

      // Fundo levemente escuro, não totalmente opaco
      const bgGradient = ctx.createLinearGradient(0, 0, 0, height);
      bgGradient.addColorStop(0, "rgba(5, 5, 10, 0.98)");
      bgGradient.addColorStop(1, "rgba(0, 0, 0, 0.98)");
      ctx.fillStyle = bgGradient;
      ctx.fillRect(0, 0, width, height);

      // Desenhar fumaça
      smokeParticles.forEach(p => {
        p.update();
        p.draw(ctx);
      });

      requestAnimationFrame(animateSmoke);
    }

    animateSmoke();
  </script>

  <!-- Lógica do antivírus -->
  <script>
    const normalizar = texto =>
      texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

    const obterPalavrasSuspeitas = () =>
      JSON.parse(localStorage.getItem("palavrasSuspeitas")) ||
      ["virus", "trojan", "malware", "worm", "hacker"];

    const salvarPalavrasSuspeitas = palavras =>
      localStorage.setItem("palavrasSuspeitas", JSON.stringify(palavras));

    const adicionarPalavra = () => {
      const input = document.querySelector("#novaPalavra");
      const palavra = input.value.trim().toLowerCase();
      if (!palavra) return;

      const palavras = obterPalavrasSuspeitas();
      if (!palavras.includes(palavra)) {
        salvarPalavrasSuspeitas([...palavras, palavra]);
        mostrarListaPalavras();
        input.value = "";
      }
    };

    const mostrarListaPalavras = () => {
      const lista = document.querySelector("#listaPalavras");
      const palavras = obterPalavrasSuspeitas();

      lista.innerHTML = palavras
        .map(p => `<li data-palavra="${p}" title="Clique para remover">${p}</li>`)
        .join("");
    };

    document.querySelector("#listaPalavras").addEventListener("click", e => {
      if (e.target.tagName !== "LI") return;

      const palavra = e.target.dataset.palavra;
      if (confirm(`Remover "${palavra}" da lista negra?`)) {
        const novas = obterPalavrasSuspeitas().filter(p => p !== palavra);
        salvarPalavrasSuspeitas(novas);
        mostrarListaPalavras();
      }
    });

    const escanearArquivos = () => {
      const input = document.querySelector("#fileInput");
      const resultados = document.querySelector("#resultados");
      resultados.innerHTML = "";

      if (!input.files.length) {
        resultados.innerHTML = `<p class="danger">Nenhum arquivo selecionado.</p>`;
        return;
      }

      const palavrasSuspeitas = obterPalavrasSuspeitas();

      [...input.files].forEach(arquivo => {
        const leitor = new FileReader();

        leitor.onload = e => {
          const conteudoOriginal = e.target.result;
          const conteudo = normalizar(conteudoOriginal);

          const encontradas = palavrasSuspeitas.filter(p => conteudo.includes(p));
          const urlsEncontradas = conteudoOriginal.match(/https?:\/\/[^\s]+/g) || [];

          const total = encontradas.length + urlsEncontradas.length;
          const risco = total === 0 ? "Baixo" : total <= 3 ? "Médio" : "Alto";

          resultados.innerHTML += `
            <div class="card">
              <strong>${arquivo.name}</strong><br>
              Palavras suspeitas: ${encontradas.join(", ") || "Nenhuma"}<br>
              URLs encontradas: ${urlsEncontradas.length}<br>
              Risco: <span class="${risco === "Baixo" ? "safe" : "danger"}">${risco}</span>
            </div>
          `;

          salvarNoHistorico(arquivo.name, encontradas, urlsEncontradas, risco);
          mostrarHistorico();
        };

        leitor.readAsText(arquivo);
      });
    };

    const salvarNoHistorico = (nome, palavras, urls, risco) => {
      const historico = JSON.parse(localStorage.getItem("historico")) || [];
      historico.push({
        nome,
        data: new Date().toLocaleString(),
        palavras,
        urls,
        risco
      });
      localStorage.setItem("historico", JSON.stringify(historico));
    };

    const mostrarHistorico = () => {
      const lista = document.querySelector("#listaHistorico");
      const historico = JSON.parse(localStorage.getItem("historico")) || [];

      lista.innerHTML = historico
        .slice()
        .reverse()
        .map(item => `
          <li>
            <strong>${item.nome}</strong> - ${item.data}<br>
            Risco: <span class="${item.risco === "Baixo" ? "safe" : "danger"}">${item.risco}</span><br>
            Palavras: ${item.palavras.join(", ") || "Nenhuma"}<br>
            URLs: ${item.urls.length}
          </li>
        `)
        .join("");
    };

    const limparHistorico = () => {
      localStorage.removeItem("historico");
      mostrarHistorico();
    };

    document.querySelector("#btnAdicionarPalavra").addEventListener("click", adicionarPalavra);
    document.querySelector("#btnEscanear").addEventListener("click", escanearArquivos);
    document.querySelector("#btnLimparHistorico").addEventListener("click", limparHistorico);

    window.addEventListener("DOMContentLoaded", () => {
      mostrarListaPalavras();
      mostrarHistorico();
    });
  </script>

</body>
</html>
