<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>NeonAV - Antivírus Web Pro</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body{
  font-family:Arial;
  background:#010401;
  color:#00ff88;
  padding:20px;
}
h1,h2{color:#00ff88}
input,button{
  background:#000;
  color:#00ff88;
  border:1px solid #00ff66;
  padding:8px;
  margin:5px 0;
  border-radius:4px;
}
button:hover{background:#00ff66;color:#000;cursor:pointer}
.card{
  background:#000;
  border:1px solid #00aa44;
  padding:10px;
  margin:10px 0;
  border-radius:6px;
}
.safe{color:#00ff66;font-weight:bold}
.danger{color:#ff5555;font-weight:bold}
.critical{color:#ff0000;font-weight:bold}
progress{width:100%;height:15px}
#bg{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1}
small{word-break:break-all}
</style>
</head>
<body>

<canvas id="bg"></canvas>

<h1>🛡️ NeonAV – Antivírus Web PRO</h1>

<input type="file" id="fileInput" multiple
accept=".txt,.log,.csv,.json,.html,.js,.pdf,.doc,.docx">
<br>
<button onclick="scan()">Escanear</button>
<button onclick="exportReport()">Exportar Relatório</button>

<progress id="progressBar" value="0" max="100"></progress>

<h2>📊 Estatísticas</h2>
<div id="stats" class="card"></div>

<h2>🔍 Resultados</h2>
<div id="resultados"></div>

<h2>🗂️ Histórico</h2>
<div id="historico"></div>
<button onclick="clearHistory()">Limpar Histórico</button>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<script>
// ===== FUNDO 3D =====
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(60,innerWidth/innerHeight,.1,1000);
camera.position.z=14;
const renderer=new THREE.WebGLRenderer({canvas:bg});
renderer.setSize(innerWidth,innerHeight);
scene.background=new THREE.Color(0x010401);
const group=new THREE.Group();scene.add(group);
for(let i=0;i<60;i++){
  const m=new THREE.Mesh(
    new THREE.SphereGeometry(.08,12,12),
    new THREE.MeshBasicMaterial({color:0x00ff66})
  );
  m.position.set((Math.random()-.5)*10,(Math.random()-.5)*10,(Math.random()-.5)*10);
  group.add(m);
}
(function anim(){
  requestAnimationFrame(anim);
  group.rotation.y+=.002;
  renderer.render(scene,camera);
})();
addEventListener("resize",()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});

// ===== ENGINE =====
const normalize=t=>t.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase();

const badDomains=["bit.ly","tinyurl",".ru",".cn",".exe"];
const badCode=["eval(","atob(","document.write","new Function"];

const advancedPatterns=[
/fromCharCode\(/i,
/unescape\(/i,
/XMLHttpRequest/i,
/fetch\(/i,
/WebSocket/i,
/document\.cookie/i,
/window\.location/i
];

const ransomwarePatterns=[
/crypto\.subtle/i,
/encrypt\(/i,
/decrypt\(/i,
/AES/i,
/RSA/i
];

const keyloggerPatterns=[
/addEventListener\(['"]keydown/i,
/addEventListener\(['"]keypress/i,
/onkeydown/i,
/onkeypress/i
];

// SHA512
async function sha512(text){
  const buf=new TextEncoder().encode(text);
  const hash=await crypto.subtle.digest("SHA-512",buf);
  return [...new Uint8Array(hash)].map(b=>b.toString(16).padStart(2,"0")).join("");
}

// ENTROPIA
function entropy(str){
  const map={};
  for(let c of str) map[c]=(map[c]||0)+1;
  let e=0,len=str.length;
  for(let k in map){
    let p=map[k]/len;
    e-=p*Math.log2(p);
  }
  return e;
}

// BASE64
function hasSuspiciousBase64(text){
  const b64=text.match(/[A-Za-z0-9+/]{200,}={0,2}/g);
  return b64?b64.length:0;
}

// ===== SCAN =====
async function scan(){
  resultados.innerHTML="";
  progressBar.value=0;

  const files=[...fileInput.files];
  let done=0;

  for(const f of files){
    const r=new FileReader();
    r.onload=async e=>{
      const raw=e.target.result;
      const text=normalize(raw);

      let score=0;
      let reasons=[];
      let snippets=[];

      const hash=await sha512(raw);
      const ent=entropy(raw);

      if(ent>4.5){score+=5;reasons.push("Alta entropia");}

      if(hasSuspiciousBase64(raw)){
        score+=5;
        reasons.push("Base64 suspeito");
      }

      const ran=ransomwarePatterns.filter(p=>p.test(raw));
      if(ran.length){score+=6;reasons.push("Ransomware");}

      const key=keyloggerPatterns.filter(p=>p.test(raw));
      if(key.length){score+=5;reasons.push("Keylogger");}

      const adv=advancedPatterns.filter(p=>p.test(raw));
      if(adv.length){score+=3;reasons.push("Malware JS");}

      const urls=raw.match(/https?:\/\/\S+/g)||[];
      if(urls.some(u=>badDomains.some(d=>u.includes(d)))){
        score+=3;reasons.push("URL suspeita");
      }

      const codeHits=badCode.filter(c=>raw.includes(c));
      if(codeHits.length){score+=4;reasons.push("Função perigosa");}

      const risk=score<=3?"Baixo":
                 score<=8?"Médio":
                 score<=15?"Alto":"Crítico";

      resultados.innerHTML+=`
      <div class="card">
        <b>${f.name}</b><br>
        <small>SHA-512: ${hash}</small><br>
        Entropia: ${ent.toFixed(2)}<br>
        Motivos: ${reasons.join(", ")||"Nenhum"}<br>
        Pontuação: ${score}<br>
        Risco: <span class="${risk=="Baixo"?"safe":risk=="Crítico"?"critical":"danger"}">${risk}</span>
      </div>`;

      saveHistory(f.name,risk);

      done++;
      progressBar.value=(done/files.length)*100;
      renderStats();
      renderHistory();
    };
    r.readAsText(f);
  }
}

// ===== HISTÓRICO =====
function saveHistory(name,risk){
  const h=JSON.parse(localStorage.getItem("history"))||[];
  h.push({name,risk,date:new Date().toLocaleString()});
  localStorage.setItem("history",JSON.stringify(h));
}

function renderHistory(){
  const h=JSON.parse(localStorage.getItem("history"))||[];
  historico.innerHTML=h.slice().reverse().map(i=>
    `<div class="card">${i.name} - ${i.date} - 
    <span class="${i.risk=="Baixo"?"safe":i.risk=="Crítico"?"critical":"danger"}">${i.risk}</span>
    </div>`).join("");
}

function renderStats(){
  const h=JSON.parse(localStorage.getItem("history"))||[];
  stats.innerHTML=`
  Arquivos escaneados: ${h.length}<br>
  Críticos: ${h.filter(x=>x.risk=="Crítico").length}
  `;
}

function clearHistory(){
  localStorage.removeItem("history");
  renderHistory();
  renderStats();
}

// EXPORTAR
function exportReport(){
  const h=JSON.parse(localStorage.getItem("history"))||[];
  const blob=new Blob([JSON.stringify(h,null,2)],{type:"application/json"});
  const a=document.createElement("a");
  a.href=URL.createObjectURL(blob);
  a.download="neonav-relatorio.json";
  a.click();
}

renderHistory();
renderStats();
</script>
</body>
</html>