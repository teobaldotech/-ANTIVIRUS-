<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>NeonAV - Antivírus Web</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body {
  font-family: Arial, sans-serif;
  background: transparent;
  color: #e0ffe0;
  padding: 20px;
}
h1,h2,h3 { color:#00ff88 }
input,button {
  background: rgba(0,0,0,.7);
  color:#e0ffe0;
  border:1px solid #00ff66;
  padding:8px;
  border-radius:4px;
  margin:5px 0;
}
button:hover {
  background:#00ff66;
  color:#000;
  cursor:pointer;
}
.card,li {
  background: rgba(0,0,0,.6);
  border:1px solid #00aa44;
  padding:10px;
  margin-bottom:10px;
  border-radius:4px;
}
.safe {color:#00ff66;font-weight:bold}
.danger {color:#ff5555;font-weight:bold}
.critical {color:#ff2222;font-weight:bold}
ul{list-style:none;padding:0}
#bg{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1}
</style>
</head>

<body>

<canvas id="bg"></canvas>

<h1>🛡️ NeonAV – Antivírus Web</h1>

<input type="file" id="fileInput" multiple
accept=".txt,.log,.csv,.json,.html,.js">
<button onclick="scan()">Escanear</button>

<h2>⚠️ Palavras Suspeitas</h2>
<input id="novaPalavra" placeholder="ex: spyware">
<button onclick="addWord()">Adicionar</button>
<ul id="listaPalavras"></ul>

<h2>📊 Estatísticas</h2>
<div id="stats" class="card"></div>

<h2>🔍 Resultados</h2>
<div id="resultados"></div>

<h2>🗂️ Histórico</h2>
<ul id="historico"></ul>
<button onclick="clearHistory()">Limpar Histórico</button>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<script>
// ================= FUNDO 3D =================
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(60,innerWidth/innerHeight,.1,1000);
camera.position.z=14;
const renderer=new THREE.WebGLRenderer({canvas:bg,alpha:true});
renderer.setSize(innerWidth,innerHeight);
scene.background=new THREE.Color(0x010401);

const group=new THREE.Group();scene.add(group);
const nodes=[];
for(let i=0;i<80;i++){
  const m=new THREE.Mesh(
    new THREE.SphereGeometry(.08,12,12),
    new THREE.MeshBasicMaterial({color:0x00ff66})
  );
  m.position.set(
    (Math.random()-.5)*10,
    (Math.random()-.5)*10,
    (Math.random()-.5)*10
  );
  nodes.push(m);group.add(m);
}
function anim(){
  requestAnimationFrame(anim);
  group.rotation.y+=.002;
  renderer.render(scene,camera);
}
anim();
addEventListener("resize",()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});

// ================= ANTIVÍRUS =================
const normalize=t=>t.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase();

const defaultWords=["virus","trojan","malware","worm","spyware"];
const badDomains=["bit.ly","tinyurl",".ru",".cn",".exe"];
const badCode=["eval(","atob(","document.write","new Function"];

const getWords=()=>JSON.parse(localStorage.getItem("words"))||defaultWords;
const saveWords=w=>localStorage.setItem("words",JSON.stringify(w));

function addWord(){
  const v=normalize(novaPalavra.value.trim());
  if(!v)return;
  const w=getWords();
  if(!w.includes(v)){w.push(v);saveWords(w);}
  novaPalavra.value="";
  renderWords();
}

function renderWords(){
  listaPalavras.innerHTML=getWords()
  .map(w=>`<li onclick="removeWord('${w}')">${w}</li>`).join("");
}
function removeWord(w){
  if(confirm("Remover "+w+"?")){
    saveWords(getWords().filter(x=>x!==w));
    renderWords();
  }
}

function scan(){
  resultados.innerHTML="";
  [...fileInput.files].forEach(f=>{
    const r=new FileReader();
    r.onload=e=>{
      const raw=e.target.result;
      const text=normalize(raw);
      let score=0;

      const found=getWords().filter(p=>{
        const re=new RegExp(`\\b${p}\\b`,"i");
        return re.test(text);
      });
      score+=found.length*2;

      const urls=raw.match(/https?:\/\/\S+/g)||[];
      const badUrls=urls.filter(u=>badDomains.some(d=>u.includes(d)));
      score+=badUrls.length*3;

      const codeHits=badCode.filter(c=>raw.includes(c));
      score+=codeHits.length*4;

      const risk=score==0?"Baixo":score<=3?"Médio":score<=7?"Alto":"Crítico";

      resultados.innerHTML+=`
      <div class="card">
        <b>${f.name}</b><br>
        Palavras: ${found.join(", ")||"Nenhuma"}<br>
        URLs suspeitas: ${badUrls.length}<br>
        Código perigoso: ${codeHits.length}<br>
        Risco: <span class="${risk=="Baixo"?"safe":risk=="Crítico"?"critical":"danger"}">${risk}</span>
      </div>`;

      saveHistory(f.name,risk);
      renderStats();
      renderHistory();
    };
    r.readAsText(f);
  });
}

function saveHistory(name,risk){
  const h=JSON.parse(localStorage.getItem("history"))||[];
  h.push({name,risk,date:new Date().toLocaleString()});
  if(h.length>50)h.shift();
  localStorage.setItem("history",JSON.stringify(h));
}

function renderHistory(){
  const h=JSON.parse(localStorage.getItem("history"))||[];
  historico.innerHTML=h.slice().reverse().map(i=>`
    <li>${i.name} - ${i.date} - 
    <span class="${i.risk=="Baixo"?"safe":i.risk=="Crítico"?"critical":"danger"}">${i.risk}</span>
    </li>`).join("");
}

function renderStats(){
  const h=JSON.parse(localStorage.getItem("history"))||[];
  stats.innerHTML=`
    Arquivos escaneados: ${h.length}<br>
    Críticos: ${h.filter(x=>x.risk=="Crítico").length}
  `;
}

function clearHistory(){
  localStorage.removeItem("history");
  renderHistory();renderStats();
}

renderWords();renderHistory();renderStats();
</script>
</body>
</html>
