<!DOCTYPE html>
<html lang="pt-BR">
<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width,initial-scale=1.0"
>

<title>NeonAV Secure PRO</title>

<!-- CSP SEGURA -->
<meta
http-equiv="Content-Security-Policy"
content="
default-src 'self';
script-src 'self' https://cdnjs.cloudflare.com;
style-src 'self' 'unsafe-inline';
worker-src 'self' blob:;
connect-src 'self';
img-src 'self' data:;
object-src 'none';
base-uri 'none';
frame-ancestors 'none';
form-action 'self';
"
/>

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background:#010401;
  color:#00ff88;
  font-family:Arial,sans-serif;
  overflow-x:hidden;
  padding:20px;
}

#bg{
  position:fixed;
  inset:0;
  z-index:-1;
}

.container{
  max-width:1200px;
  margin:auto;
}

.panel{
  background:#000;
  border:1px solid #00aa55;
  border-radius:10px;
  padding:20px;
  margin-bottom:20px;
}

h1,h2{
  margin-bottom:15px;
}

button,
input[type=file]{
  background:#000;
  color:#00ff88;
  border:1px solid #00ff88;
  padding:10px;
  border-radius:5px;
}

button{
  cursor:pointer;
  margin-top:10px;
}

button:hover{
  background:#00ff88;
  color:#000;
}

progress{
  width:100%;
  height:20px;
  margin-top:15px;
}

.card{
  background:#000;
  border:1px solid #00aa55;
  border-radius:8px;
  padding:15px;
  margin-top:10px;
}

.safe{
  color:#00ff66;
  font-weight:bold;
}

.medium{
  color:#ffee55;
  font-weight:bold;
}

.danger{
  color:#ff5555;
  font-weight:bold;
}

.critical{
  color:#ff0000;
  font-weight:bold;
}

small{
  word-break:break-all;
}

.stat-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:10px;
}

.stat{
  border:1px solid #00aa55;
  border-radius:8px;
  padding:10px;
  text-align:center;
}

</style>

</head>

<body>

<canvas id="bg"></canvas>

<div class="container">

<h1>🛡️ NeonAV Secure PRO</h1>

<div class="panel">

<input
type="file"
id="fileInput"
multiple
accept=".txt,.js,.json,.html,.csv,.log"
/>

<br>

<button id="scanBtn">
Escanear
</button>

<button id="exportBtn">
Exportar
</button>

<button id="clearBtn">
Limpar Histórico
</button>

<progress
id="progressBar"
value="0"
max="100">
</progress>

</div>

<div class="panel">

<h2>📊 Estatísticas</h2>

<div
class="stat-grid"
id="stats">
</div>

</div>

<div class="panel">

<h2>🔍 Resultados</h2>

<div id="resultados"></div>

</div>

<div class="panel">

<h2>🗂️ Histórico</h2>

<div id="historico"></div>

</div>

</div>

<!-- THREE -->
<script
src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"
crossorigin="anonymous">
</script>

<script>

// ======================================================
// CONFIG
// ======================================================

const MAX_FILE_SIZE =
10 * 1024 * 1024;

const MAX_FILES = 50;

const MAX_ANALYSIS =
500000;

// ======================================================
// THREE BG
// ======================================================

const bg =
document.getElementById("bg");

const scene =
new THREE.Scene();

const camera =
new THREE.PerspectiveCamera(
  60,
  innerWidth/innerHeight,
  .1,
  1000
);

camera.position.z = 14;

const renderer =
new THREE.WebGLRenderer({
  canvas:bg,
  antialias:true
});

renderer.setSize(
  innerWidth,
  innerHeight
);

scene.background =
new THREE.Color(0x010401);

const group =
new THREE.Group();

scene.add(group);

for(let i=0;i<70;i++){

  const mesh =
  new THREE.Mesh(

    new THREE.SphereGeometry(
      .08,
      12,
      12
    ),

    new THREE.MeshBasicMaterial({
      color:0x00ff88
    })

  );

  mesh.position.set(
    (Math.random()-.5)*12,
    (Math.random()-.5)*12,
    (Math.random()-.5)*12
  );

  group.add(mesh);

}

(function animate(){

  requestAnimationFrame(animate);

  group.rotation.y += .0015;

  renderer.render(scene,camera);

})();

addEventListener("resize",()=>{

  camera.aspect =
  innerWidth/innerHeight;

  camera.updateProjectionMatrix();

  renderer.setSize(
    innerWidth,
    innerHeight
  );

});

// ======================================================
// YARA RULES
// ======================================================

const yaraRules = [

{
  name:"Keylogger",
  patterns:[
    "keydown",
    "keypress",
    "document.cookie"
  ],
  threshold:2,
  score:8
},

{
  name:"Stealer",
  patterns:[
    "localStorage",
    "navigator.sendBeacon",
    "fetch("
  ],
  threshold:2,
  score:10
},

{
  name:"Obfuscation",
  patterns:[
    "eval(",
    "atob(",
    "Function(",
    "fromCharCode"
  ],
  threshold:1,
  score:7
}

];

// ======================================================
// SHA512
// ======================================================

async function sha512(text){

  const encoded =
  new TextEncoder().encode(text);

  const hashBuffer =
  await crypto.subtle.digest(
    "SHA-512",
    encoded
  );

  return [...new Uint8Array(hashBuffer)]
  .map(
    b=>b.toString(16)
    .padStart(2,"0")
  )
  .join("");

}

// ======================================================
// SAFE STORAGE
// ======================================================

function getHistory(){

  try{

    return JSON.parse(
      localStorage.getItem(
        "neonav-history"
      )
    ) || [];

  }catch{

    return [];
  }

}

function saveHistory(entry){

  const history =
  getHistory();

  history.push(entry);

  // limite
  if(history.length > 500){

    history.shift();

  }

  localStorage.setItem(
    "neonav-history",
    JSON.stringify(history)
  );

}

// ======================================================
// SAFE ELEMENT
// ======================================================

function createTextElement(
  tag,
  text,
  className=""
){

  const el =
  document.createElement(tag);

  el.textContent = text;

  if(className){

    el.className = className;

  }

  return el;

}

// ======================================================
// RENDER HISTORY
// ======================================================

function renderHistory(){

  const history =
  getHistory();

  const container =
  document.getElementById("historico");

  container.textContent = "";

  history
  .slice()
  .reverse()
  .forEach(item=>{

    const card =
    document.createElement("div");

    card.className = "card";

    card.appendChild(
      createTextElement(
        "b",
        item.fileName
      )
    );

    card.appendChild(
      document.createElement("br")
    );

    card.appendChild(
      createTextElement(
        "small",
        item.hash
      )
    );

    card.appendChild(
      document.createElement("br")
    );

    card.appendChild(
      createTextElement(
        "div",
        "Data: " + item.date
      )
    );

    const risk =
    createTextElement(
      "div",
      "Risco: " + item.risk
    );

    risk.className =
      item.risk === "Baixo"
      ? "safe"
      : item.risk === "Médio"
      ? "medium"
      : item.risk === "Alto"
      ? "danger"
      : "critical";

    card.appendChild(risk);

    container.appendChild(card);

  });

}

// ======================================================
// STATS
// ======================================================

function renderStats(){

  const history =
  getHistory();

  const stats =
  document.getElementById("stats");

  stats.textContent = "";

  const critical =
  history.filter(
    x=>x.risk==="Crítico"
  ).length;

  const high =
  history.filter(
    x=>x.risk==="Alto"
  ).length;

  const total =
  history.length;

  const items = [

    ["Arquivos",total],
    ["Críticos",critical],
    ["Alto risco",high]

  ];

  for(const [label,value] of items){

    const box =
    document.createElement("div");

    box.className = "stat";

    box.appendChild(
      createTextElement(
        "h3",
        String(value)
      )
    );

    box.appendChild(
      createTextElement(
        "p",
        label
      )
    );

    stats.appendChild(box);

  }

}

// ======================================================
// EXPORT
// ======================================================

function exportReport(){

  const history =
  getHistory();

  const blob =
  new Blob(
    [
      JSON.stringify(
        history,
        null,
        2
      )
    ],
    {
      type:"application/json"
    }
  );

  const a =
  document.createElement("a");

  a.href =
  URL.createObjectURL(blob);

  a.download =
  "neonav-report.json";

  a.click();

  URL.revokeObjectURL(a.href);

}

// ======================================================
// CLEAR
// ======================================================

function clearHistory(){

  localStorage.removeItem(
    "neonav-history"
  );

  renderHistory();

  renderStats();

}

// ======================================================
// WORKER CODE
// ======================================================

const workerCode = `

importScripts(
"https://cdnjs.cloudflare.com/ajax/libs/acorn/8.11.3/acorn.min.js"
);

self.onmessage = e=>{

const {
  raw,
  fileName,
  yaraRules
} = e.data;

let score = 0;

let reasons = [];

const sample =
raw.slice(0,500000);

// ======================
// ENTROPY
// ======================

function entropy(str){

  const map = {};

  for(const c of str){

    map[c]=(map[c]||0)+1;

  }

  let e = 0;

  for(const k in map){

    const p =
    map[k]/str.length;

    e -= p*Math.log2(p);

  }

  return e;

}

const ent =
entropy(
  sample.slice(0,100000)
);

if(ent > 4.5){

  score += 5;

  reasons.push(
    "Alta entropia"
  );

}

// ======================
// YARA
// ======================

for(const rule of yaraRules){

  let matched = 0;

  for(const p of rule.patterns){

    if(sample.includes(p)){

      matched++;

    }

  }

  if(
    matched >= rule.threshold
  ){

    score += rule.score;

    reasons.push(rule.name);

  }

}

// ======================
// AST
// ======================

try{

  const ast =
  acorn.parse(
    sample,
    {
      ecmaVersion:"latest"
    }
  );

  const stack=[ast];

  while(stack.length){

    const node =
    stack.pop();

    if(
      !node ||
      typeof node !== "object"
    ){
      continue;
    }

    // eval()

    if(
      node.type==="CallExpression" &&
      node.callee &&
      node.callee.name==="eval"
    ){

      score += 6;

      reasons.push("eval()");

    }

    // Function()

    if(
      node.type==="NewExpression" &&
      node.callee &&
      node.callee.name==="Function"
    ){

      score += 6;

      reasons.push(
        "Dynamic Function"
      );

    }

    // cookie

    if(
      node.type==="MemberExpression" &&
      node.property &&
      node.property.name==="cookie"
    ){

      score += 4;

      reasons.push(
        "Cookie Access"
      );

    }

    for(const k in node){

      if(
        typeof node[k] === "object"
      ){

        stack.push(node[k]);

      }

    }

  }

}catch{

  reasons.push(
    "AST inválida"
  );

}

// ======================
// URLS
// ======================

const urls =
sample.match(
/https?:\\/\\/[^\\s"'<>]+/g
) || [];

const suspicious = [
  "bit.ly",
  ".onion",
  "tinyurl"
];

for(const url of urls){

  try{

    const parsed =
    new URL(url);

    if(
      suspicious.some(
        d=>parsed.hostname.includes(d)
      )
    ){

      score += 5;

      reasons.push(
        "URL suspeita"
      );

    }

  }catch{}

}

// ======================
// BASE64
// ======================

const b64 =
sample.match(
/[A-Za-z0-9+/]{200,}={0,2}/g
);

if(b64 && b64.length < 20){

  score += 4;

  reasons.push(
    "Base64 suspeito"
  );

}

// ======================
// RESULT
// ======================

const risk =
score <= 3
? "Baixo"
: score <= 8
? "Médio"
: score <= 15
? "Alto"
: "Crítico";

self.postMessage({

  fileName,
  entropy:ent,
  score,
  reasons,
  risk

});

};
`;

// ======================================================
// WORKER URL
// ======================================================

const workerBlob =
new Blob(
  [workerCode],
  {
    type:"application/javascript"
  }
);

const workerURL =
URL.createObjectURL(workerBlob);

// ======================================================
// SCAN
// ======================================================

async function scan(){

const results =
document.getElementById(
  "resultados"
);

const progress =
document.getElementById(
  "progressBar"
);

results.textContent = "";

progress.value = 0;

const files = [

  ...document
  .getElementById("fileInput")
  .files

];

if(!files.length){

  alert(
    "Selecione arquivos"
  );

  return;

}

if(files.length > MAX_FILES){

  alert(
    "Máximo 50 arquivos"
  );

  return;

}

let done = 0;

for(const file of files){

  if(file.size > MAX_FILE_SIZE){

    alert(
      file.name +
      " excede limite"
    );

    continue;

  }

  // MIME
  const allowed = [

    "text/plain",
    "application/json",
    "text/html",
    "text/javascript",
    "application/javascript"

  ];

  if(
    file.type &&
    !allowed.includes(file.type)
  ){

    alert(
      file.name +
      " tipo não permitido"
    );

    continue;

  }

  const reader =
  new FileReader();

  reader.onload =
  async e=>{

    try{

      const buffer =
      e.target.result;

      const decoder =
      new TextDecoder();

      const raw =
      decoder.decode(buffer);

      const hash =
      await sha512(raw);

      const worker =
      new Worker(workerURL);

      // timeout
      const timeout =
      setTimeout(()=>{

        worker.terminate();

      },5000);

      worker.postMessage({

        raw,
        fileName:file.name,
        yaraRules

      });

      worker.onmessage =
      ev=>{

        clearTimeout(timeout);

        const data =
        ev.data;

        const card =
        document.createElement(
          "div"
        );

        card.className =
        "card";

        card.appendChild(
          createTextElement(
            "b",
            data.fileName
          )
        );

        card.appendChild(
          document.createElement(
            "br"
          )
        );

        card.appendChild(
          createTextElement(
            "small",
            "SHA512: " + hash
          )
        );

        card.appendChild(
          createTextElement(
            "div",
            "Entropia: " +
            data.entropy.toFixed(2)
          )
        );

        card.appendChild(
          createTextElement(
            "div",
            "Pontuação: " +
            data.score
          )
        );

        card.appendChild(
          createTextElement(
            "div",
            "Motivos: " +
            data.reasons.join(", ")
          )
        );

        const risk =
        createTextElement(
          "div",
          "Risco: " +
          data.risk
        );

        risk.className =
          data.risk==="Baixo"
          ? "safe"
          : data.risk==="Médio"
          ? "medium"
          : data.risk==="Alto"
          ? "danger"
          : "critical";

        card.appendChild(risk);

        results.appendChild(card);

        saveHistory({

          fileName:
          data.fileName,

          hash,

          risk:
          data.risk,

          date:
          new Date()
          .toLocaleString()

        });

        done++;

        progress.value =
        (done/files.length)*100;

        renderHistory();

        renderStats();

        worker.terminate();

      };

    }catch(err){

      console.error(err);

    }

  };

  reader.readAsArrayBuffer(
    file
  );

}

}

// ======================================================
// EVENTS
// ======================================================

document
.getElementById("scanBtn")
.addEventListener(
  "click",
  scan
);

document
.getElementById("exportBtn")
.addEventListener(
  "click",
  exportReport
);

document
.getElementById("clearBtn")
.addEventListener(
  "click",
  clearHistory
);

// ======================================================
// INIT
// ======================================================

renderHistory();

renderStats();

</script>

</body>
</html>