/* =========================================================
   IOC
========================================================= */

function detectIOCs(text){

const found = [];

const patterns = [

{
type:"URL",
regex:/https?:\/\/[^\s"'<>]+/gi
},

{
type:"IPv4",
regex:/\b(?:\d{1,3}\.){3}\d{1,3}\b/g
},

{
type:"Email",
regex:/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi
},

{
type:"Domain",
regex:/\b[a-z0-9.-]+\.(?:com|net|org|io|ru|cn|xyz|top|online|site|onion)\b/gi
}

];

for(const item of patterns){

const matches =
text.match(item.regex) || [];

for(const match of matches){

if(!found.some(
x=>x.value.toLowerCase() ===
match.toLowerCase()
)){

found.push({
type:item.type,
value:match
});

}

}

}

return found.slice(0,50);

}


/* =========================================================
   URLS SUSPEITAS
========================================================= */

function suspiciousURLs(iocs){

const suspiciousDomains = [

"bit.ly",
"tinyurl.com",
"t.co",
"goo.gl",
"cutt.ly",
"is.gd",
"rb.gy",
"ow.ly"

];

return iocs.filter(ioc=>{

if(ioc.type !== "URL"){
return false;
}

const value =
ioc.value.toLowerCase();

return suspiciousDomains.some(
domain=>value.includes(domain)
)
||
value.includes(".onion");

});

}


/* =========================================================
   REGRAS
========================================================= */

function runRules(text){

const lower =
text.toLowerCase();

const detections = [];

let score = 0;

for(const rule of RULES){

const matched = [];

for(const pattern of rule.patterns){

if(
lower.includes(pattern.toLowerCase())
){

matched.push(pattern);

}

}

if(matched.length){

score += rule.score;

detections.push({

rule:rule.name,
score:rule.score,
patterns:matched

});

}

}

return {
score,
detections
};

}


