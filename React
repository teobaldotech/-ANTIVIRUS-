.toLowerCase();

const matchesSearch =
!query ||
searchable.includes(query);

const matchesRisk =
filter === "all" ||
item.risk === filter;

return matchesSearch &&
matchesRisk;

});


if(sort === "score"){

list.sort(
(a,b)=>b.score-a.score
);

