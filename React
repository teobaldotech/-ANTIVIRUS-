const units = [
"B",
"KB",
"MB",
"GB"
];

const i = Math.floor(
Math.log(bytes) / Math.log(1024)
);

return (
bytes /
Math.pow(1024,i)
).toFixed(i === 0 ? 0 : 2)
+" "+units[i];

}


