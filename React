========================================================= */

async function analyzeFile(file,index,total){

const maxMB =
Number($("sizeLimit").value);

const maxBytes =
maxMB * 1024 * 1024;

log(
`Analisando ${file.name}`,
"SCAN"
);

if(file.size > maxBytes){

log(
`${file.name}: tamanho excede ${maxMB} MB`,
"WARNING"
);

return {

id:uuid(),

name:file.name,

size:file.size,

type:file.type || "desconhecido",

modified:file.lastModified,

timestamp:Date.now(),

score:0,

risk:"medium",

riskLabel:"NÃO ANALISADO",

error:
`Arquivo excede o limite de ${maxMB} MB.`,

hash:"",

entropy:0,

detections:[],

iocs:[],

suspiciousURLs:[]

};

}


const buffer =
await file.arrayBuffer();


let hash = "";

try{

hash = await sha512(buffer);

}catch(error){

log(
"Erro no SHA-512: "+error.message,
"ERROR"
);

}


const bytes =
new Uint8Array(buffer);


const entropy =
$("cfgEntropy").checked
?
calculateByteEntropy(bytes)
:
0;


const text =
await readTextSafely(file);


const rules =
runRules(text);


let score =
rules.score;


const reasons = [];


for(const detection of rules.detections){

reasons.push(
`${detection.rule}: ${detection.patterns.join(", ")}`
);

}


/* extensão */

if(
$("cfgExtension").checked
){

const lowerName =
file.name.toLowerCase();

const extension =
"."+
(
lowerName.includes(".")
?
lowerName.split(".").pop()
:
""
);

if(
SUSPICIOUS_EXTENSIONS.includes(extension)
){

score += 3;

reasons.push(
`Extensão potencialmente executável/sensível: ${extension}`
);

}

}


/* entropia */

if(
$("cfgEntropy").checked &&
entropy >= 7.2
){

score += 5;

reasons.push(
`Entropia de bytes elevada: ${entropy.toFixed(2)} bits`
);

}


/* IOC */

let iocs = [];

if(
$("cfgIoc").checked
){

iocs = detectIOCs(text);

if(iocs.length){

reasons.push(
`${iocs.length} IOC(s) detectado(s)`
);

}

}


/* URLs */

let suspicious = [];

if(
$("cfgUrls").checked
){

suspicious =
suspiciousURLs(iocs);

if(suspicious.length){

score += 5;

reasons.push(
`${suspicious.length} URL(s) potencialmente suspeita(s)`
);

}

}


/* limite */

score =
Math.min(score,100);


const risk =
riskFromScore(score);


return {

id:uuid(),

name:file.name,

size:file.size,

type:file.type || "desconhecido",

modified:file.lastModified,

timestamp:Date.now(),

score,

risk:risk.level,

riskLabel:risk.label,

hash,

entropy,

detections:rules.detections,

iocs,

suspiciousURLs:suspicious,

reasons

};

}


